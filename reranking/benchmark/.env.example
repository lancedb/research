# Copy this file to .env and paste keys after the equals signs (no quotes needed).
# .env is ignored by Git. Do not paste keys into chat or commit them.

# Voyage AI (the benchmark uses rerank-3)
VOYAGE_API_KEY=

# Jev / TypeSafe
TYPESAFE_API_KEY=

# NVIDIA NGC / hosted model API credential (not Brev authentication)
NVIDIA_API_KEY=

# Brev GPU cloud: user token from Account Settings > CLI
BREV_TOKEN=

# Brev personal API key: Account Settings > API Keys, for unattended cleanup
# Choose the experiment's organization and Read & Write access.
BREV_API_KEY=
